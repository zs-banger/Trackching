-- Main categories (parent_id IS NULL) and subcategories (parent_id = a main one).
CREATE TABLE category (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('EXPENSE', 'INCOME')),
    parent_id INTEGER REFERENCES category(id),
    color INTEGER NOT NULL,              -- 0xAARRGGBB, e.g. 0xFFE07A00
    sort_order INTEGER NOT NULL DEFAULT 0,
    icon TEXT NOT NULL DEFAULT '🏷️'
);

-- Same name can't appear twice under one parent. Main categories have no parent (NULL),
-- and NULLs never count as equal, so we compare COALESCE(parent_id, 0) instead.
CREATE UNIQUE INDEX category_unique_name
ON category(kind, COALESCE(parent_id, 0), name COLLATE NOCASE);

insert:
INSERT INTO category(name, kind, parent_id, color, sort_order)
VALUES (?, ?, ?, ?, ?);

lastId:
SELECT last_insert_rowid();

countAll:
SELECT COUNT(*) FROM category;

-- Categories you can log against (ones with no subcategories),
-- most used first; ties keep the default order.
mostUsed:
SELECT c.id, c.name, c.color, p.name AS parent_name, COUNT(t.id) AS uses
FROM category c
LEFT JOIN category p ON p.id = c.parent_id
LEFT JOIN txn t ON t.category_id = c.id
WHERE c.kind = ?
  AND NOT EXISTS (SELECT 1 FROM category k WHERE k.parent_id = c.id)
GROUP BY c.id
ORDER BY uses DESC, c.sort_order, c.id
LIMIT ?;

-- New category, placed last.
create:
INSERT INTO category(name, kind, parent_id, color, icon, sort_order)
VALUES (?, ?, ?, ?, ?, (SELECT COALESCE(MAX(sort_order), -1) + 1 FROM category));

-- `IS` (not `=`) so that "parent_id IS NULL" matches main categories too.
nameTaken:
SELECT COUNT(*) FROM category
WHERE kind = ? AND parent_id IS ? AND name = ? COLLATE NOCASE;

namesUnder:
SELECT name FROM category WHERE kind = ? AND parent_id IS ?;

mains:
SELECT id, name, color, icon FROM category
WHERE kind = ? AND parent_id IS NULL
ORDER BY sort_order, id;

parentInfo:
SELECT kind, parent_id FROM category WHERE id = ?;

-- Every category of one kind with its OWN total between two moments.
-- The date filter sits in the JOIN (not in WHERE) so unused categories still come back, at 0.
monthTotals:
SELECT c.id, c.name, c.color, c.icon, c.parent_id,
       CAST(COALESCE(SUM(t.centavos), 0) AS INTEGER) AS total
FROM category c
LEFT JOIN txn t
       ON t.category_id = c.id
      AND t.occurred_at >= ?
      AND t.occurred_at < ?
WHERE c.kind = ?
GROUP BY c.id
ORDER BY c.sort_order, c.id;

categoryById:
SELECT * FROM category WHERE id = ?;

subIds:
SELECT id FROM category WHERE parent_id = ?;

-- Categories you can log against (no subcategories), for "Move transactions to".
leaves:
SELECT c.id, c.name, p.name AS parent_name
FROM category c
LEFT JOIN category p ON p.id = c.parent_id
WHERE c.kind = ?
  AND NOT EXISTS (SELECT 1 FROM category k WHERE k.parent_id = c.id)
ORDER BY c.sort_order, c.id;

countOthersOfKind:
SELECT COUNT(*) FROM category WHERE kind = ? AND id NOT IN ?;

deleteSubs:
DELETE FROM category WHERE parent_id = ?;

deleteOne:
DELETE FROM category WHERE id = ?;

eraseAll:
DELETE FROM category;

-- Main categories first, so a subcategory's parent is always in before it.
backupAll:
SELECT * FROM category ORDER BY parent_id IS NOT NULL, id;

backupInsert:
INSERT INTO category(id, name, kind, parent_id, color, sort_order, icon)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- One category by kind, main (or none) and name, ignoring case (P3-16).
findCategory:
SELECT id FROM category WHERE kind = ? AND parent_id IS ? AND name = ? COLLATE NOCASE LIMIT 1;
