CREATE TABLE txn (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL CHECK (kind IN ('EXPENSE', 'INCOME', 'TRANSFER', 'ADJUSTMENT', 'IOU')),
    centavos INTEGER NOT NULL CHECK (centavos > 0 OR (kind IN ('ADJUSTMENT', 'IOU') AND centavos <> 0)),
    account_id INTEGER NOT NULL REFERENCES account(id),
    to_account_id INTEGER REFERENCES account(id),
    category_id INTEGER REFERENCES category(id), -- NULL for transfers
    occurred_at INTEGER NOT NULL,
    event_id INTEGER REFERENCES event(id), -- NULL = not part of an event
    repeat_id INTEGER REFERENCES repeat_rule(id) -- NULL = not from a repeat
);

-- Makes "newest first" fast even with thousands of rows.
CREATE INDEX txn_by_time ON txn(occurred_at);

insert:
INSERT INTO txn(kind, centavos, account_id, to_account_id, category_id, occurred_at)
VALUES (?, ?, ?, ?, ?, ?);

delete:
DELETE FROM txn WHERE id = ?;

lastId:
SELECT last_insert_rowid();

-- "Paid from" default: the account of the most recently *entered* expense, skipping archived accounts.
-- By id, not by date: a backdated expense still counts as the last one you entered.
lastAccountUsed:
SELECT t.account_id FROM txn t
JOIN account a ON a.id = t.account_id
WHERE t.kind = 'EXPENSE' AND a.archived = 0
ORDER BY t.id DESC
LIMIT 1;

-- Income and spending between two moments. Transfers are left out on purpose.
totals:
SELECT
    CAST(COALESCE(SUM(CASE WHEN kind = 'INCOME'  THEN centavos END), 0) AS INTEGER) AS income,
    CAST(COALESCE(SUM(CASE WHEN kind = 'EXPENSE' THEN centavos END), 0) AS INTEGER) AS spent
FROM txn
WHERE occurred_at >= ? AND occurred_at < ?;

-- Every transaction, newest first, with the names the list shows.
history:
SELECT t.id, t.kind, t.centavos, t.occurred_at,
       c.name AS category_name,
       a.name AS account_name,
       ta.name AS to_account_name,
       t.account_id,
       t.to_account_id
FROM txn t
JOIN account a ON a.id = t.account_id
LEFT JOIN account ta ON ta.id = t.to_account_id
LEFT JOIN category c ON c.id = t.category_id
WHERE t.kind <> 'IOU' -- IOU money shows in the list from P3-8
ORDER BY t.occurred_at DESC, t.id DESC;

byId:
SELECT * FROM txn WHERE id = ?;

update:
UPDATE txn
SET kind = ?, centavos = ?, account_id = ?, to_account_id = ?, category_id = ?, occurred_at = ?
WHERE id = ?;

-- Puts a deleted row back with its original id ("Deleted · Undo").
restore:
INSERT INTO txn VALUES ?;

usageOf:
SELECT COUNT(*) FROM txn WHERE category_id IN ?;

moveCategory:
UPDATE txn SET category_id = ? WHERE category_id IN ?;

setEvent:
UPDATE txn SET event_id = ? WHERE id = ?;

movements:
SELECT kind, centavos, account_id, to_account_id, occurred_at FROM txn;

idsForEvent:
SELECT id FROM txn WHERE event_id = ?;

-- Before deleting an event: its transactions stay, they just stop being tagged.
untagEvent:
UPDATE txn SET event_id = NULL WHERE event_id = ?;

-- An event's spending per main category. A subcategory counts under its main.
eventSpending:
SELECT COALESCE(p.id, c.id) AS id,
       COALESCE(p.name, c.name) AS name,
       COALESCE(p.color, c.color) AS color,
       CAST(COALESCE(SUM(t.centavos), 0) AS INTEGER) AS total
FROM txn t
JOIN category c ON c.id = t.category_id
LEFT JOIN category p ON p.id = c.parent_id
WHERE t.event_id = ? AND t.kind = 'EXPENSE'
GROUP BY COALESCE(p.id, c.id)
ORDER BY total DESC;

eraseAll:
DELETE FROM txn;

countAll:
SELECT COUNT(*) FROM txn;

backupAll:
SELECT * FROM txn ORDER BY id;

backupInsert:
INSERT INTO txn(id, kind, centavos, account_id, to_account_id, category_id, occurred_at, event_id, repeat_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- One row per transaction for Export CSV, with names instead of ids.
csvRows:
SELECT t.occurred_at, t.kind, t.centavos,
       a.name AS account, b.name AS to_account,
       COALESCE(p.name, c.name) AS category,
       CASE WHEN p.id IS NULL THEN NULL ELSE c.name END AS subcategory,
       e.name AS event,
       pe.name AS person
FROM txn t
JOIN account a ON a.id = t.account_id
LEFT JOIN account b ON b.id = t.to_account_id
LEFT JOIN category c ON c.id = t.category_id
LEFT JOIN category p ON p.id = c.parent_id
LEFT JOIN event e ON e.id = t.event_id
LEFT JOIN iou_payment ip ON ip.txn_id = t.id
LEFT JOIN iou i ON i.txn_id = t.id OR i.id = ip.iou_id
LEFT JOIN person pe ON pe.id = i.person_id
ORDER BY t.occurred_at, t.id;

setRepeat:
UPDATE txn SET repeat_id = ? WHERE id = ?;

countForRepeat:
SELECT COUNT(*) FROM txn WHERE repeat_id = ?;
