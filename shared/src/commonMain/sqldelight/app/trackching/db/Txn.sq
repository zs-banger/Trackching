CREATE TABLE txn (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL CHECK (kind IN ('EXPENSE', 'INCOME', 'TRANSFER', 'ADJUSTMENT')),
    centavos INTEGER NOT NULL CHECK (centavos > 0 OR (kind = 'ADJUSTMENT' AND centavos <> 0)),
    account_id INTEGER NOT NULL REFERENCES account(id),
    to_account_id INTEGER REFERENCES account(id),
    category_id INTEGER REFERENCES category(id), -- NULL for transfers
    occurred_at INTEGER NOT NULL,
    event_id INTEGER REFERENCES event(id) -- NULL = not part of an event
);

-- Makes "newest first" fast even with thousands of rows.
CREATE INDEX txn_by_time ON txn(occurred_at);

insert:
INSERT INTO txn(kind, centavos, account_id, to_account_id, category_id, occurred_at)
VALUES (?, ?, ?, ?, ?, ?);

delete:
DELETE FROM txn WHERE id = ?;

lastId:
SELECT last_insert_rowid();

-- "Paid from" default: the account of the most recently *entered* expense, skipping archived accounts.
-- By id, not by date: a backdated expense still counts as the last one you entered.
lastAccountUsed:
SELECT t.account_id FROM txn t
JOIN account a ON a.id = t.account_id
WHERE t.kind = 'EXPENSE' AND a.archived = 0
ORDER BY t.id DESC
LIMIT 1;

-- Income and spending between two moments. Transfers are left out on purpose.
totals:
SELECT
    CAST(COALESCE(SUM(CASE WHEN kind = 'INCOME'  THEN centavos END), 0) AS INTEGER) AS income,
    CAST(COALESCE(SUM(CASE WHEN kind = 'EXPENSE' THEN centavos END), 0) AS INTEGER) AS spent
FROM txn
WHERE occurred_at >= ? AND occurred_at < ?;

-- Every transaction, newest first, with the names the list shows.
history:
SELECT t.id, t.kind, t.centavos, t.occurred_at,
       c.name AS category_name,
       a.name AS account_name,
       ta.name AS to_account_name
FROM txn t
JOIN account a ON a.id = t.account_id
LEFT JOIN account ta ON ta.id = t.to_account_id
LEFT JOIN category c ON c.id = t.category_id
ORDER BY t.occurred_at DESC, t.id DESC;

byId:
SELECT * FROM txn WHERE id = ?;

update:
UPDATE txn
SET kind = ?, centavos = ?, account_id = ?, to_account_id = ?, category_id = ?, occurred_at = ?
WHERE id = ?;

-- Puts a deleted row back with its original id ("Deleted · Undo").
restore:
INSERT INTO txn VALUES ?;

usageOf:
SELECT COUNT(*) FROM txn WHERE category_id IN ?;

moveCategory:
UPDATE txn SET category_id = ? WHERE category_id IN ?;

setEvent:
UPDATE txn SET event_id = ? WHERE id = ?;