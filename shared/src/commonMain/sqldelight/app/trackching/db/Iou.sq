-- People you have IOUs with. Remembered so the name field can suggest them.
CREATE TABLE person (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE CHECK (length(trim(name)) > 0)
);

-- One IOU. kind: OWE = I owe them, OWED = they owe me, HOLDING = I'm keeping their money.
-- opened_on / due_on are 'YYYY-MM-DD', like event.
-- interest_value: centavos for FLAT, basis points a month for MONTHLY (500 = 5.00%).
-- txn_id: the 'IOU' transaction that moved the money in or out of my account.
CREATE TABLE iou (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL CHECK (kind IN ('OWE', 'OWED', 'HOLDING')),
    person_id INTEGER NOT NULL REFERENCES person(id),
    centavos INTEGER NOT NULL CHECK (centavos > 0),
    what_for TEXT NOT NULL DEFAULT '',
    opened_on TEXT NOT NULL,
    due_on TEXT,
    interest_kind TEXT NOT NULL DEFAULT 'NONE' CHECK (interest_kind IN ('NONE', 'FLAT', 'MONTHLY')),
    interest_value INTEGER NOT NULL DEFAULT 0 CHECK (interest_value >= 0),
    note TEXT NOT NULL DEFAULT '',
    txn_id INTEGER REFERENCES txn(id),
    spend_txn_id INTEGER REFERENCES txn(id), -- "It paid for something" (P3-8): the spending it stands for. See 6.sqm
    CHECK (kind <> 'HOLDING' OR interest_kind = 'NONE'),
    CHECK (interest_kind <> 'MONTHLY' OR due_on IS NOT NULL),
    CHECK (due_on IS NULL OR due_on >= opened_on)
);

-- One payment on an IOU, split into principal and interest. The money itself is txn_id (P3-9).
CREATE TABLE iou_payment (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    iou_id INTEGER NOT NULL REFERENCES iou(id),
    txn_id INTEGER NOT NULL REFERENCES txn(id),
    principal_centavos INTEGER NOT NULL CHECK (principal_centavos >= 0),
    interest_centavos INTEGER NOT NULL DEFAULT 0 CHECK (interest_centavos >= 0)
);

-- An IOU paid back in parts (P3-17). Each part is saved up front, so "They differ" amounts are kept as typed.
-- centavos is the whole part, interest included; interest_centavos is its share of the interest.
-- state: WAITING until the check-in saves or skips it. payment_id: the payment it was saved as.
CREATE TABLE iou_installment (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    iou_id INTEGER NOT NULL REFERENCES iou(id),
    n INTEGER NOT NULL,
    due_on TEXT NOT NULL,
    centavos INTEGER NOT NULL CHECK (centavos > 0),
    interest_centavos INTEGER NOT NULL DEFAULT 0 CHECK (interest_centavos >= 0),
    state TEXT NOT NULL DEFAULT 'WAITING' CHECK (state IN ('WAITING', 'SAVED', 'SKIPPED')),
    payment_id INTEGER REFERENCES iou_payment(id)
);

-- Does nothing if the name is already there ("juan" counts as "Juan").
addPerson:
INSERT OR IGNORE INTO person(name) VALUES (?);

personId:
SELECT id FROM person WHERE name = ?;

-- Names that start with what's typed, the most recently used first.
namesLike:
SELECT p.name FROM person p
LEFT JOIN iou i ON i.person_id = p.id
WHERE p.name LIKE :typed || '%'
GROUP BY p.id
ORDER BY MAX(i.id) DESC, p.name
LIMIT 5;

insert:
INSERT INTO iou(kind, person_id, centavos, what_for, opened_on, due_on, interest_kind, interest_value, note, txn_id, spend_txn_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Edit IOU (P3-8). The transactions are updated separately.
update:
UPDATE iou
SET kind = ?, person_id = ?, centavos = ?, what_for = ?, opened_on = ?, due_on = ?,
    interest_kind = ?, interest_value = ?, note = ?, txn_id = ?, spend_txn_id = ?
WHERE id = ?;

lastId:
SELECT last_insert_rowid();

byId:
SELECT * FROM iou WHERE id = ?;

paymentsOf:
SELECT * FROM iou_payment WHERE iou_id = ? ORDER BY id;

eraseAll {
    DELETE FROM iou_installment;
    DELETE FROM iou_payment;
    DELETE FROM iou;
    DELETE FROM person;
}

backupPeople:
SELECT * FROM person ORDER BY id;

backupIous:
SELECT * FROM iou ORDER BY id;

backupPayments:
SELECT * FROM iou_payment ORDER BY id;

backupInsertPerson:
INSERT INTO person(id, name) VALUES (?, ?);

backupInsertIou:
INSERT INTO iou VALUES ?;

backupInsertPayment:
INSERT INTO iou_payment VALUES ?;

-- Every IOU with its person and what's been paid so far, for the IOUs tab.
-- The math (interest, what's left, overdue) happens in IouList.kt, where it's tested.
iouList:
SELECT i.id, i.kind, p.id AS person_id, p.name AS person, i.centavos, i.what_for,
       i.opened_on, i.due_on, i.interest_kind, i.interest_value,
       CAST(COALESCE(SUM(ip.principal_centavos + ip.interest_centavos), 0) AS INTEGER) AS paid
FROM iou i
JOIN person p ON p.id = i.person_id
LEFT JOIN iou_payment ip ON ip.iou_id = i.id
GROUP BY i.id
ORDER BY i.id;

-- One IOU with its person's name, for the IOU screen (P3-7).
iouDetail:
SELECT i.id, i.kind, p.name AS person, i.centavos, i.what_for, i.opened_on, i.due_on,
       i.interest_kind, i.interest_value, i.note
FROM iou i
JOIN person p ON p.id = i.person_id
WHERE i.id = ?;

-- An IOU's payments, newest first, with the time and account of the money that moved (P3-7).
paymentRows:
SELECT ip.id, ip.txn_id, ip.principal_centavos, ip.interest_centavos, t.occurred_at, a.name AS account
FROM iou_payment ip
JOIN txn t ON t.id = ip.txn_id
JOIN account a ON a.id = t.account_id
WHERE ip.iou_id = ?
ORDER BY t.occurred_at DESC, ip.id DESC;

paymentById:
SELECT * FROM iou_payment WHERE id = ?;

-- Recording payments comes with P3-9; the tests use it already.
insertPayment:
INSERT INTO iou_payment(iou_id, txn_id, principal_centavos, interest_centavos) VALUES (?, ?, ?, ?);

deletePayment:
DELETE FROM iou_payment WHERE id = ?;

-- Puts a payment back with its old id, for Undo.
restorePayment:
INSERT INTO iou_payment(id, iou_id, txn_id, principal_centavos, interest_centavos) VALUES (?, ?, ?, ?, ?);

-- Money I'm holding for others, by the account it came into (P3-9). Holding has no interest.
heldByAccount:
SELECT t.account_id, i.centavos,
       CAST(COALESCE(SUM(ip.principal_centavos + ip.interest_centavos), 0) AS INTEGER) AS paid
FROM iou i
JOIN txn t ON t.id = i.txn_id
LEFT JOIN iou_payment ip ON ip.iou_id = i.id
WHERE i.kind = 'HOLDING'
GROUP BY i.id;

-- Every payment's money, for the Flow summary's Debt payments and Handed back lines (P3-9).
paymentMoves:
SELECT t.occurred_at, t.account_id, i.kind,
       CAST(ip.principal_centavos + ip.interest_centavos AS INTEGER) AS centavos
FROM iou_payment ip
JOIN txn t ON t.id = ip.txn_id
JOIN iou i ON i.id = ip.iou_id;

-- Installments (P3-17).

installmentsOf:
SELECT * FROM iou_installment WHERE iou_id = ? ORDER BY n;

-- Parts that are due and not handled yet, oldest first, with who and which way.
dueInstallments:
SELECT ins.*, i.kind, p.name AS person,
       (SELECT COUNT(*) FROM iou_installment a WHERE a.iou_id = ins.iou_id) AS total_parts
FROM iou_installment ins
JOIN iou i ON i.id = ins.iou_id
JOIN person p ON p.id = i.person_id
WHERE ins.state = 'WAITING' AND ins.due_on <= :today
ORDER BY ins.due_on, ins.iou_id, ins.n;

allWaitingInstallments:
SELECT * FROM iou_installment WHERE state = 'WAITING';

insertInstallment:
INSERT INTO iou_installment(iou_id, n, due_on, centavos, interest_centavos) VALUES (?, ?, ?, ?, ?);

-- Only while nothing is handled: Edit IOU replaces the whole plan.
deleteInstallmentsOf:
DELETE FROM iou_installment WHERE iou_id = ?;

countHandled:
SELECT COUNT(*) FROM iou_installment WHERE iou_id = ? AND state <> 'WAITING';

-- Saved or skipped. Only from WAITING, so a double tap does nothing the second time.
markInstallment:
UPDATE iou_installment SET state = :state, payment_id = :paymentId WHERE id = :id AND state = 'WAITING';

installmentById:
SELECT * FROM iou_installment WHERE id = ?;

-- Deleting a payment the check-in saved: that part is waiting again.
unmarkByPayment:
UPDATE iou_installment SET state = 'WAITING', payment_id = NULL WHERE payment_id = ?;

installmentOfPayment:
SELECT id FROM iou_installment WHERE payment_id = ?;

setInstallmentPayment:
UPDATE iou_installment SET state = 'SAVED', payment_id = ? WHERE id = ?;

backupInstallments:
SELECT * FROM iou_installment ORDER BY id;

backupInsertInstallment:
INSERT INTO iou_installment VALUES ?;


-- Phase 3 fixes (audit #2): the IOU whose "paid for" spending this transaction is.
iouOfSpend:
SELECT p.name FROM iou i JOIN person p ON p.id = i.person_id WHERE i.spend_txn_id = ?;

-- Audit #5: what's been paid on an IOU, interest included.
paidOn:
SELECT CAST(COALESCE(SUM(principal_centavos + interest_centavos), 0) AS INTEGER) FROM iou_payment WHERE iou_id = ?;
